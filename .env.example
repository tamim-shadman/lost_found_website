# Lost & Found Bangladesh — Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.

# Application Configuration
APP_NAME="Lost & Found Bangladesh"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://lostfoundbd.com

# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=l_fbd
DB_USER=root
DB_PASS=your_strong_database_password
DB_CHARSET=utf8mb4

# SQLite Local Fallback (Used automatically if MySQL is unreachable)
SQLITE_PATH=database/local_dev.sqlite

# Security & Session Settings
SESSION_SECRET=replace_with_64_char_cryptographically_secure_random_string
CSRF_SECRET=replace_with_64_char_cryptographically_secure_random_string
SESSION_LIFETIME=86400
SECURE_COOKIES=true

# Stripe Tokenized Donations (PCI-DSS Compliant)
STRIPE_PUBLIC_KEY=pk_test_replace_with_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key

# Contact & Emergency Hotlines
EMERGENCY_POLICE_HOTLINE=999
ADMIN_CONTACT_EMAIL=support@lostfoundbd.com
